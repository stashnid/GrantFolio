FROM node:24.18.1-bookworm-slim
RUN apt-get update && apt-get install -y --no-install-recommends openjdk-17-jre-headless && rm -rf /var/lib/apt/lists/*
RUN npm install --global firebase-tools@14.22.0
WORKDIR /workspace
COPY firebase.json ./
CMD ["firebase", "emulators:start", "--only", "auth", "--project", "demo-grantfolio", "--import", "/var/lib/grantfolio-auth/export", "--export-on-exit", "/var/lib/grantfolio-auth/export"]
