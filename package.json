{
  "name": "grantfolio",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web 'npm:dev:api' 'npm:dev:web'",
    "dev:api": "node --env-file-if-exists=.env ./node_modules/tsx/dist/cli.mjs watch backend/src/server.ts",
    "dev:web": "vite --config frontend/vite.config.ts",
    "build": "tsc -p backend/tsconfig.json && vite build --config frontend/vite.config.ts",
    "typecheck": "tsc --noEmit -p backend/tsconfig.json && tsc --noEmit -p frontend/tsconfig.json",
    "migrate": "node --env-file-if-exists=.env --import tsx backend/src/migrate.ts",
    "start": "node --env-file-if-exists=.env backend/dist/server.js",
    "test": "node --env-file-if-exists=.env --import tsx --test backend/test/*.test.ts",
    "migrate:prod": "node backend/dist/migrate.js",
    "test:auth-persistence": "node scripts/test-auth-persistence.mjs",
    "grants:refresh": "node --env-file-if-exists=.env --import tsx backend/src/grant-sync-cli.ts",
    "grants:discover": "node --env-file-if-exists=.env --import tsx backend/src/funding-monitor-cli.ts",
    "grants:smart-sync": "node --env-file-if-exists=.env --import tsx backend/src/smart-monitor-cli.ts",
    "sync:playbooks": "node --env-file-if-exists=.env --import tsx backend/src/playbooks/syncPlaybooks.ts",
    "sync:official-docs": "node --env-file-if-exists=.env --import tsx backend/src/knowledge/indexOfficialDocs.ts",
    "sync:embeddings": "node --env-file-if-exists=.env --import tsx backend/src/matching/hybridSearch.ts",
    "inspect:xlsx": "node --import tsx scripts/inspect-xlsx-template.ts",
    "eval:assistant": "node --env-file-if-exists=.env --import tsx scripts/eval-assistant.ts",
    "test:red-team": "node --env-file-if-exists=.env --import tsx scripts/red-team-calibration.ts"
  },
  "dependencies": {
    "express": "5.1.0",
    "fflate": "0.8.3",
    "firebase": "13.3.0",
    "firebase-admin": "14.5.1",
    "pg": "8.16.3",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/express": "5.0.3",
    "@types/node": "24.10.0",
    "@types/pg": "8.15.5",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "@vitejs/plugin-react": "5.1.0",
    "concurrently": "9.2.5",
    "prettier": "3.6.2",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "vite": "7.3.8"
  },
  "overrides": {
    "@grpc/grpc-js": "1.13.6"
  }
}
