# Local emulator only. Never use these values for production.
NODE_ENV=development
AUTH_MODE=emulator
FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
FIREBASE_PROJECT_ID=demo-grantfolio
DATABASE_URL=postgresql://grantfolio:grantfolio@127.0.0.1:55432/grantfolio
VITE_AUTH_MODE=emulator
VITE_FIREBASE_API_KEY=demo-api-key
VITE_FIREBASE_PROJECT_ID=demo-grantfolio
VITE_FIREBASE_AUTH_DOMAIN=demo-grantfolio.firebaseapp.com
VITE_FIREBASE_APP_ID=demo-app

PORT=18080

# Gemini API configuration (optional server-side)
GEMINI_API_KEY=
# GEMINI_MODEL is legacy and affects utility only; prefer the role-specific settings.
GEMINI_CHAT_MODEL=gemini-3.5-flash
GEMINI_PRO_MODEL=
GEMINI_UTILITY_MODEL=gemini-3.5-flash-lite
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
AI_ASSISTANT_SYSTEM_PROMPT_OVERRIDE=
GEMINI_VERTEX_PROJECT=

# Optional acquiring checkout; server-side secrets only. HTTPS origin, no path.
MONOBANK_ACQUIRING_TOKEN=
PUBLIC_BASE_URL=

# Jar payment receiver: generate secret with python3 -c 'import secrets; print(secrets.token_hex(32))'
# Store production values in Secret Manager; never commit a real secret/account ID.
MONOBANK_JAR_WEBHOOK_SECRET=
MONOBANK_JAR_ACCOUNT_ID=
MONOBANK_JAR_URL=https://send.monobank.ua/jar/9GcNmEBdxD
# Enable payment instructions only AFTER registering webhook on deployed GET endpoint.
MONOBANK_JAR_ENABLED=false

# Explicit opt-in to billable query/document embedding calls; lexical fallback otherwise.
GEMINI_EMBEDDINGS_ENABLED=false
